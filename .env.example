# Copy to .env for npm run dev:api (do not commit .env).
# For Wrangler local development, use the same values in .dev.vars.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
# Set the real shop timezone before enabling customer checkout.
SQUARE_TIMEZONE=Australia/Perth
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:3001/api/webhooks/square


SQUARE_LOCATION_ID=
WEBSITE_ORIGIN=http://localhost:3000
