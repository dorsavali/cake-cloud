# Copy to .env for npm run dev:api (do not commit .env).
# For Wrangler local development, use the same values in .dev.vars.
SQUARE_ENVIRONMENT=sandbox
# Keep false locally. This still allows Sandbox checkout, while Production mode
# can be used to preview the live catalog without creating real payment links.
SQUARE_PRODUCTION_CHECKOUT_ENABLED=false
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
# Set the real shop timezone before enabling customer checkout.
SQUARE_TIMEZONE=Australia/Perth
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:3001/api/webhooks/square


SQUARE_LOCATION_ID=
WEBSITE_ORIGIN=http://localhost:3000

# Transactional email is configured in wrangler.jsonc and uses Cloudflare's
# EMAIL binding. The standalone Node development API disables email.
