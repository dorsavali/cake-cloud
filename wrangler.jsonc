{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cake-cloud",
  "main": "./api/src/index.ts",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "vars": {
    // Runtime-specific values live outside source control:
    // - local development reads SQUARE_ENVIRONMENT and WEBSITE_ORIGIN from .env
    // - Cloudflare Workers use their own Variables and Secrets
    "SQUARE_TIMEZONE": "Australia/Perth",
    "EMAIL_ENABLED": "true",
    "SMTP_HOST": "mail.cake-cloud.com.au",
    "SMTP_PORT": "587",
    "SMTP_SECURITY": "starttls",
    "SMTP_HELLO_USERNAME": "hello-noreply@cake-cloud.com.au",
    "EMAIL_TEST_SMTP_HOST": "mail.libremobileos.com",
    "EMAIL_TEST_SMTP_PORT": "465",
    "EMAIL_TEST_SMTP_SECURITY": "tls",
    "EMAIL_TEST_SMTP_USERNAME": "dorsa",
    "EMAIL_TEST_SMTP_FROM": "dorsa@libremobileos.com",
    "EMAIL_TEST_SMTP_RECIPIENT": "dorsa@libremobileos.com"
  },
  "secrets": {
    "required": [
      "SQUARE_ACCESS_TOKEN",
      "SQUARE_LOCATION_ID",
      "SQUARE_APPLICATION_ID",
      "SQUARE_WEBHOOK_SIGNATURE_KEY",
      "SQUARE_WEBHOOK_NOTIFICATION_URL",
      "SMTP_HELLO_PASSWORD",
      "SMTP_ORDERS_USERNAME",
      "SMTP_ORDERS_PASSWORD",
      "EMAIL_TEST_TOKEN",
      "EMAIL_TEST_SMTP_PASSWORD"
    ]
  },
  "triggers": {
    "crons": ["0 0,12 * * *"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "r2_buckets": [
    {
      "binding": "STOREFRONT_CACHE",
      "bucket_name": "cake-cloud-briefs"
    },
    {
      "binding": "CAKE_BRIEFS",
      "bucket_name": "cake-cloud-briefs"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_INVENTORY_RESERVATIONS",
        "class_name": "DailyInventoryReservations"
      }
    ]
  },
  "exports": {
    "DailyInventoryReservations": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "./website/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  }
}
