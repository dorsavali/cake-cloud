{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cake-cloud",
  "main": "./api/src/index.ts",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "routes": [
    {
      "pattern": "cake-cloud.dorsavalli.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "SQUARE_ENVIRONMENT": "sandbox",
    "SQUARE_TIMEZONE": "Australia/Perth",
    "WEBSITE_ORIGIN": "https://cake-cloud.dorsavalli.com",
    "EMAIL_ENABLED": "false",
    "SMTP_HOST": "mail.cake-cloud.com.au",
    "SMTP_PORT": "465",
    "SMTP_SECURITY": "tls",
    "SMTP_HELLO_USERNAME": "hello-noreply@cake-cloud.com.au"
  },
  "secrets": {
    "required": [
      "SQUARE_ACCESS_TOKEN",
      "SQUARE_LOCATION_ID",
      "SQUARE_APPLICATION_ID",
      "SQUARE_WEBHOOK_SIGNATURE_KEY",
      "SQUARE_WEBHOOK_NOTIFICATION_URL",
      "SMTP_HELLO_PASSWORD",
      "SMTP_ORDERS_USERNAME",
      "SMTP_ORDERS_PASSWORD"
    ]
  },
  "triggers": {
    "crons": ["0 */2 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_INVENTORY_RESERVATIONS",
        "class_name": "DailyInventoryReservations"
      }
    ]
  },
  "exports": {
    "DailyInventoryReservations": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "./website/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  }
}
