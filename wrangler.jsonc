{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cake-cloud",
  "main": "./api/src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./website/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  }
}
